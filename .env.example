# Tududi API Configuration (base URL; trailing /api or /api/v1 is normalized automatically)
TUDUDI_API_URL=http://localhost:3000

# Authentication: Use EITHER API key OR email/password
# Option 1: API Key (for newer Tududi versions)
TUDUDI_API_KEY=your-api-key-here

# Option 2: Email/Password (for older Tududi versions without API token support)
# TUDUDI_EMAIL=your-email@example.com
# TUDUDI_PASSWORD=your-password

# Logging
LOG_LEVEL=info

# Transport: stdio (default) or http (Streamable HTTP on /mcp with /health check)
# TRANSPORT=http
# PORT=3000
# Optional Bearer token required for Authorization: Bearer <token> on /mcp when TRANSPORT=http
# MCP_AUTH_TOKEN=your-secret-bearer-token

